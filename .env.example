# Public, client-safe Supabase config (EXPO_PUBLIC_ = inlined into the bundle).
# The publishable key is public by design; RLS is what protects data.
# NEVER add a provider secret (Gemini, Google Places, service_role) here —
# those live only in Supabase Edge Function env. See VADDI_V4.md §7.1.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
